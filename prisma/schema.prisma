generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  usernameLower String?   @unique
  createdAt     DateTime  @default(now())
  emailVerified DateTime?
  image         String?
  name          String?
  displayName   String?
  faculty       String?
  course        Int?
  bio           String?
  interests     String[]  @default([])
  pinnedPostId  Int?
  hasOnboarded  Boolean   @default(false)
  inviteAcceptedAt DateTime?
  role          Role      @default(USER)
  bannedUntil   DateTime?
  banReason     String?
  shadowBannedAt DateTime?
  shadowBanReason String?
  accounts      Account[]
  deletedPosts  Post[]    @relation("PostsDeletedBy")
  followers     Follow[]  @relation("Follower")
  following     Follow[]  @relation("Following")
  likes         Like[]
  posts         Post[]
  communityMemberships CommunityMember[]
  reports       Report[]  @relation("ReportsByUser")
  resolvedReports Report[] @relation("ReportsResolvedBy")
  appeals       Appeal[]
  resolvedAppeals Appeal[] @relation("AppealsResolvedBy")
  sessions      Session[]
  auditLogs     AuditLog[]
  feedback      Feedback[]
  notifications Notification[]
  notificationsAsActor Notification[] @relation("NotificationActor")
  conversations ConversationParticipant[]
  messages      Message[]
  errorLogs     ErrorLog[]
  resolvedErrorLogs ErrorLog[] @relation("ErrorResolvedBy")
  devices       UserDevice[]
  e2eTrusts     E2eTrust[]

  @@index([bannedUntil])
  @@index([shadowBannedAt])
}

model E2eTrust {
  id                 String   @id @default(cuid())
  userId             String
  peerDeviceId       String
  peerIdentityKeyHash String
  verifiedAt         DateTime @default(now())
  revokedAt          DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  peerDevice UserDevice @relation(fields: [peerDeviceId], references: [id], onDelete: Cascade)

  @@unique([userId, peerDeviceId])
  @@index([userId, verifiedAt])
}

model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityKey   UserIdentityKey?
  signedPreKeys UserSignedPreKey[]
  oneTimePreKeys UserOneTimePreKey[]

  @@index([userId, lastSeenAt])
}

model UserIdentityKey {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  publicKey String
  createdAt DateTime @default(now())

  device    UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model UserSignedPreKey {
  id        String   @id @default(cuid())
  deviceId  String
  keyId     String
  publicKey String
  signature String
  createdAt DateTime @default(now())
  expiresAt DateTime?

  device UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId, createdAt])
}

model UserOneTimePreKey {
  id         String   @id @default(cuid())
  deviceId   String
  keyId      String
  publicKey  String
  createdAt  DateTime @default(now())
  consumedAt DateTime?

  device UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId, createdAt])
  @@index([deviceId, consumedAt])
}

model Community {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   @default("")
  type        CommunityType @default(OPEN)
  isPrivate   Boolean   @default(false)
  facultyCode String?
  courseYear  Int?
  createdAt   DateTime @default(now())
  posts       Post[]
  members     CommunityMember[]

  @@index([type, isPrivate])
  @@index([type, facultyCode, courseYear])
}

model Post {
  id          Int       @id @default(autoincrement())
  content     String
  createdAt   DateTime  @default(now())
  authorId    String
  communityId Int?
  likeCount   Int       @default(0)
  replyCount  Int       @default(0)
  replyToId   Int?
  repostCount Int       @default(0)
  repostOfId  Int?
  deletedAt   DateTime?
  deletedById String?
  deleteReason String?
  likes       Like[]
  reports     Report[]
  community   Community? @relation(fields: [communityId], references: [id])
  author      User      @relation(fields: [authorId], references: [id])
  deletedBy   User?     @relation("PostsDeletedBy", fields: [deletedById], references: [id])
  replyTo     Post?     @relation("PostReplies", fields: [replyToId], references: [id])
  replies     Post[]    @relation("PostReplies")
  repostOf    Post?     @relation("PostReposts", fields: [repostOfId], references: [id])
  reposts     Post[]    @relation("PostReposts")
  notifications Notification[] @relation("NotificationPost")
  replyNotifications Notification[] @relation("NotificationReply")

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([replyToId, createdAt])
  @@index([communityId, createdAt])
  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@index([authorId, deletedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  postId    Int?
  replyId   Int?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor  User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post   Post? @relation("NotificationPost", fields: [postId], references: [id], onDelete: Cascade)
  reply  Post? @relation("NotificationReply", fields: [replyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  REPLY
  LIKE
  FOLLOW
  MENTION
  SECURITY
}

model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime?
  lastMessageId String?
  encryptionMode EncryptionMode @default(CLOUD)

  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt, id])
}

enum EncryptionMode {
  CLOUD
  E2E
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
  @@index([userId, conversationId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  contentCiphertext String?
  contentIv      String?
  contentTag     String?
  contentKeyId   String?
  contentDekWrapped String?
  contentDekIv   String?
  contentDekTag  String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  deletedAt      DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, deletedAt, createdAt])
  @@index([expiresAt])
  @@index([senderId, createdAt])
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    String
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followerId, createdAt])
  @@index([followingId])
  @@index([followingId, createdAt])
}

model Report {
  id            String       @id @default(cuid())
  postId        Int
  reporterId    String
  reason        String
  category      ReportCategory?
  severity      Int?
  status        ReportStatus @default(OPEN)
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  resolvedById  String?
  resolutionNote String?
  post          Post         @relation(fields: [postId], references: [id])
  reporter      User         @relation("ReportsByUser", fields: [reporterId], references: [id])
  resolvedBy    User?        @relation("ReportsResolvedBy", fields: [resolvedById], references: [id])

  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@index([status, severity, createdAt])
}

model ModerationAction {
  id         String       @id @default(cuid())
  source     ActionSource @default(MANUAL)
  action     String
  actorId    String?
  targetType String
  targetId   String
  reason     String
  metadata   Json?
  createdAt  DateTime     @default(now())
  expiresAt  DateTime?

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([source, createdAt])
}

model CommunityMember {
  id          String           @id @default(cuid())
  communityId Int
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  joinedAt    DateTime         @default(now()) @map("createdAt")
  community   Community        @relation(fields: [communityId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
}

model Appeal {
  id             String       @id @default(cuid())
  userId         String
  targetType     String
  targetId       String
  reason         String
  status         AppealStatus @default(OPEN)
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?
  user           User         @relation(fields: [userId], references: [id])
  resolvedBy     User?        @relation("AppealsResolvedBy", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String
  message     String
  currentPath String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
}

model ErrorLog {
  id          String   @id @default(cuid())
  level       String   @default("ERROR")
  message     String
  stack       String?
  route       String?
  method      String?
  status      Int?
  userId      String?
  ip          String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  resolvedById String?
  user        User?    @relation(fields: [userId], references: [id])
  resolvedBy  User?    @relation("ErrorResolvedBy", fields: [resolvedById], references: [id])

  @@index([createdAt])
  @@index([resolvedAt])
  @@index([route, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?  @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  logs        JobLog[]

  @@index([status, runAt])
  @@index([lockedAt])
  @@index([type, status, runAt])
}

model JobLog {
  id        String    @id @default(cuid())
  jobId     String
  status    JobStatus
  message   String?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  TEACHER
  MOD
  ADMIN
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum ReportCategory {
  SPAM
  HARASSMENT
  ILLEGAL
  OTHER
}

enum ActionSource {
  MANUAL
  AUTO
}

enum CommunityMemberRole {
  MEMBER
  MOD
  OWNER
}

enum CommunityType {
  OPEN
  FACULTY
  COURSE
  TEACHERS
}

enum AppealStatus {
  OPEN
  APPROVED
  DENIED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}
